# Backend-only configuration
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Defaults to backend/data/multiverse.db when omitted. Use an absolute path when overriding.
# DATABASE_URL=sqlite:////absolute/path/to/multiverse.db

# Safe to expose: this is only the backend's public base URL.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Phase 4 supports the fully offline mock provider only. It requires no key.
# OpenAI provider settings are intentionally deferred to Phase 8.
NARRATIVE_PROVIDER=mock
