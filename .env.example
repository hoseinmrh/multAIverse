# Backend-only configuration
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Defaults to backend/data/multiverse.db when omitted. Use an absolute path when overriding.
# DATABASE_URL=sqlite:////absolute/path/to/multiverse.db

# The fully offline mock provider is the default and requires no key.
NARRATIVE_PROVIDER=mock
# Optional backend-only OpenAI Responses API configuration. Suggested models:
# gpt-5.6-luna for lowest cost, or gpt-5.6-terra for stronger prose.
# OPENAI_MODEL has no application default; set it only for OpenAI mode.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
OPENAI_FALLBACK_TO_MOCK=true
# Optional generation controls. Leave unset to use the selected model's defaults;
# enable only supported values after evaluating quality, latency, and cost.
# OPENAI_REASONING_EFFORT=low
# OPENAI_VERBOSITY=low
